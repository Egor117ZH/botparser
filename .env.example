# === Бот (получить у @BotFather -> /newbot) ===
BOT_TOKEN=

# Твой telegram id. Можно оставить пустым — напиши боту, он сам пришлёт id
ADMIN_ID=

# === Userbot для чтения каналов (https://my.telegram.org -> API development tools) ===
TG_API_ID=
TG_API_HASH=
# номер аккаунта, под которым читаем каналы, в формате +79991234567
TG_PHONE=

# === Нейронка через Polza AI ===
POLZA_API_KEY=
POLZA_BASE_URL=https://polza.ai/api/v1
# список моделей: https://polza.ai/models (формат провайдер/модель)
POLZA_MODEL=openai/gpt-4o-mini
# Polza — российский сервис, прокси для неё не нужен

# === Прокси (из РФ телега режется — без прокси может висеть) ===
# Обычный socks5 или http прокси, работает и для бота, и для чтения каналов:
#   PROXY=socks5://логин:пароль@1.2.3.4:1080
#   PROXY=http://логин:пароль@1.2.3.4:8080
# без логина: socks5://1.2.3.4:1080
PROXY=

# MTProto-прокси (те, что из ссылок t.me/proxy?server=...&port=...&secret=...)
# формат host:port:secret. Работает ТОЛЬКО для чтения каналов, боту всё равно нужен PROXY.
# секреты, начинающиеся на ee (fake-tls), не поддерживаются.
MTPROXY=

# 1 — парсить сайты тоже через PROXY (если зарубежные сайты не открываются из РФ)
PROXY_FOR_SITES=0

# === Настройки сбора (можно не трогать) ===
HOURS_BACK=48
POSTS_PER_CHANNEL=50
ARTICLES_PER_SITE=8
TOP_N=10
MAX_PER_SOURCE=3
MIN_RELEVANCE=6
